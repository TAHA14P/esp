-- LocalScript: StarterPlayer -> StarterPlayerScripts
-- Client-only movement GUI: WalkSpeed, JumpPower, Fly, Noclip
-- Requires Rayfield

-- Load Rayfield
local Rayfield = loadstring(game:HttpGet("https://raw.githubusercontent.com/shlexware/Rayfield/main/source"))()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Humanoid = Character:FindFirstChildOfClass("Humanoid")
local RootPart = Character:FindFirstChild("HumanoidRootPart") or Character.PrimaryPart

-- Refresh character references on respawn
local function refreshChar()
    Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    Humanoid = Character:FindFirstChildOfClass("Humanoid")
    RootPart = Character:FindFirstChild("HumanoidRootPart") or Character.PrimaryPart
end

LocalPlayer.CharacterAdded:Connect(refreshChar)

-- State
local state = {
    walkSpeed = Humanoid and Humanoid.WalkSpeed or 16,
    jumpPower = Humanoid and Humanoid.JumpPower or 50,
    flySpeed = 50,
    flying = false,
    noclip = false,
}

local bodyVelocity, bodyGyro

local function enableFly()
    if state.flying then return end
    refreshChar()
    if not RootPart or not Humanoid then return end
    Humanoid.PlatformStand = true

    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(1e5,1e5,1e5)
    bodyVelocity.P = 1250
    bodyVelocity.Velocity = Vector3.new(0,0,0)
    bodyVelocity.Parent = RootPart

    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(4e4,4e4,4e4)
    bodyGyro.P = 3000
    bodyGyro.CFrame = RootPart.CFrame
    bodyGyro.Parent = RootPart

    state.flying = true
end

local function disableFly()
    if not state.flying then return end
    if bodyVelocity then bodyVelocity:Destroy() bodyVelocity=nil end
    if bodyGyro then bodyGyro:Destroy() bodyGyro=nil end
    if Humanoid then pcall(function() Humanoid.PlatformStand=false end) end
    state.flying=false
end

local function setNoclip(enabled)
    state.noclip = enabled
    if enabled and Character then
        for _, p in ipairs(Character:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanCollide = false
            end
        end
    end
end

-- ===================== Rayfield Window =====================
local Window = Rayfield:CreateWindow({
    Name = "Movement GUI",
    LoadingTitle = "Movement GUI Loaded",
    LoadingSubtitle = "Client-only",
    ConfigurationSaving = {Enabled = true, FolderName = "MovementConfigs", FileName = "Default"},
    Discord = {Enabled=false},
    KeySystem = false
})

local Tab = Window:CreateTab("Player Movement")

-- WalkSpeed
Tab:CreateSlider({
    Name="WalkSpeed",
    Range={16,500},
    Increment=1,
    Suffix=" ws",
    CurrentValue=state.walkSpeed,
    Flag="WalkSpeed",
    Callback=function(val)
        state.walkSpeed=val
        if Humanoid then pcall(function() Humanoid.WalkSpeed=val end) end
    end
})

-- JumpPower
Tab:CreateSlider({
    Name="JumpPower",
    Range={0,500},
    Increment=1,
    Suffix=" jp",
    CurrentValue=state.jumpPower,
    Flag="JumpPower",
    Callback=function(val)
        state.jumpPower=val
        if Humanoid then pcall(function() Humanoid.JumpPower=val end) end
    end
})

-- Fly Speed
Tab:CreateSlider({
    Name="FlySpeed",
    Range={10,300},
    Increment=1,
    Suffix=" fs",
    CurrentValue=state.flySpeed,
    Flag="FlySpeed",
    Callback=function(val)
        state.flySpeed=val
    end
})

-- Fly Toggle
Tab:CreateToggle({
    Name="Fly",
    CurrentValue=false,
    Flag="FlyToggle",
    Callback=function(enabled)
        if enabled then enableFly() else disableFly() end
    end
})

-- Noclip Toggle
Tab:CreateToggle({
    Name="Noclip",
    CurrentValue=false,
    Flag="NoclipToggle",
    Callback=function(enabled)
        setNoclip(enabled)
    end
})

-- Optional: hotkey to show/hide GUI
Window:SetValue("ToggleKeybind", Enum.KeyCode.RightShift)

